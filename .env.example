# =============================================================================
# ANZARA - Environment Variables Example
# Copy this file to .env and fill in real values
# Never commit .env to source control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Anzara
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
APP_LOCALE=en
APP_FALLBACK_LOCALE=bn
APP_CURRENCY=BDT
APP_TIMEZONE=Asia/Dhaka
TRUST_PROXY=loopback

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://anzara:anzara@localhost:5432/anzara_dev?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10"
DATABASE_DIRECT_URL="postgresql://anzara:anzara@localhost:5432/anzara_dev?schema=public"

# -----------------------------------------------------------------------------
# Redis (reserved - not consumed yet; safe to leave blank)
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars-long-secret
JWT_REFRESH_SECRET=change-me-in-production-different-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_RESET_SECRET=change-me-in-production-yet-another-secret-min-32-chars
JWT_ISSUER=anzara
JWT_AUDIENCE=anzara-api
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Email
#
# With NO RESEND_API_KEY, emails are written to ./emails-outbox/*.json so
# flows work end-to-end with zero third-party setup (great for dev / first
# 100 customers). Set RESEND_API_KEY later to route real email via Resend.
# The EmailProvider factory picks the right impl - no code change required.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Anzara <noreply@anzara.com>"
EMAIL_OUTBOX_DIR=./emails-outbox

# -----------------------------------------------------------------------------
# Media (Cloudinary - optional)
#
# Default is ASSET_PROVIDER=local (uploads to ./uploads, served by /uploads).
# Flip to "cloudinary" and fill the CLOUDINARY_* keys later to switch.
# No code change required; the AssetProvider factory picks the right impl.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# -----------------------------------------------------------------------------
# Local uploads (dev / default provider)
# -----------------------------------------------------------------------------
ASSET_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=8388608

# -----------------------------------------------------------------------------
# Payments (SSLCommerz) - Add when you apply and get credentials
# -----------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/order/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/order/failed
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/order/cancelled
SSLCOMMERZ_IPN_URL=http://localhost:4000/api/payments/sslcommerz/ipn

# -----------------------------------------------------------------------------
# Courier (pluggable - leave empty until you pick a provider)
# -----------------------------------------------------------------------------
COURIER_PROVIDER=manual
COURIER_API_KEY=
COURIER_API_SECRET=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DISABLE_RATE_LIMIT=false
